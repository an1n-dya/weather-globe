{
  "name": "weather-globe",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "data": "tsx scripts/build-earth.ts && tsx scripts/build-regions.ts && tsx scripts/build-cities.ts && tsx scripts/build-icons.ts",
    "check:reference": "tsx scripts/check-reference.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "delaunator": "^5.1.0",
    "fflate": "^0.8.3",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.2.1",
    "d3-geo": "^3.1.2",
    "jpeg-js": "^0.4.4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
